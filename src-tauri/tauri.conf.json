{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-mate",
  "version": "0.1.0",
  "identifier": "com.screenmate.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ScreenMate",
        "width": 440,
        "height": 640,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "center": false
      },
      {
        "label": "settings",
        "title": "ScreenMate - 캐릭터 매니저",
        "url": "settings.html",
        "width": 680,
        "height": 640,
        "minWidth": 580,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
