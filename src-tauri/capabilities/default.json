{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "ScreenMate capabilities for event listening and dragging",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-start-dragging"
  ]
}
